{
	email {$ACME_EMAIL}
	# h1/h2 only: keeps the firewall at 22/80/443 (no UDP/443 for HTTP/3).
	servers {
		protocols h1 h2
	}
}

{$SENTINEL_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	request_body {
		max_size 50MB
	}

	# WebSocket (Caddy upgrades automatically); no buffering, long-lived.
	@ws path /api/stream/live
	handle @ws {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 1h
				write_timeout 1h
			}
		}
	}

	@backend path /api/* /v1/*
	handle @backend {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				response_header_timeout 120s
			}
		}
	}

	handle {
		reverse_proxy frontend:8080
	}
}
