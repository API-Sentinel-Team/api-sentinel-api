# Copy to .env.prod (chmod 600) or generate with ./generate-secrets.sh. NEVER commit .env.prod.
# Placeholders only. Every CHANGE_ME must be replaced.

# --- Release -----------------------------------------------------------------
# Image tag for all five application images (ghcr.io/api-sentinel-team/api-sentinel-*:<tag>).
SENTINEL_VERSION=CHANGE_ME

# --- Edge / TLS --------------------------------------------------------------
# Public DNS name pointing at this VPS (the A record must exist before first start, for ACME).
SENTINEL_DOMAIN=sentinel.example.com
ACME_EMAIL=ops@example.com

# --- Scan safety -------------------------------------------------------------
# Comma-separated hostnames scans may target. No wildcards ("*" is rejected in production).
PENTEST_TARGET_ALLOWLIST=api.customer-example.com

# --- Secrets (generate-secrets.sh fills these) -------------------------------
# URL-safe (hex) because they are embedded in DATABASE_URL / REDIS_URL.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
# >= 32 random bytes
JWT_SECRET=CHANGE_ME
API_KEY=CHANGE_ME
# Fernet key (urlsafe base64 of 32 bytes). Losing it makes stored secrets unreadable: back it up.
ENCRYPTION_KEY=CHANGE_ME
# Changing the pepper invalidates all sensor keys.
SENSOR_KEY_HASH_PEPPER=CHANGE_ME
CICD_GATE_SIGNING_SECRET=CHANGE_ME

# --- Optional tuning (defaults shown) ----------------------------------------
# UNIFIED_PIPELINE_MODE=shadow
# STARTUP_ENABLE_RECON_SCHEDULER=true
# RECON_SCHEDULER_ENABLED=true
# STARTUP_ENABLE_CONTINUOUS_TESTING=false
# CONTINUOUS_TESTING_ENABLED=false
# STARTUP_ENABLE_OPENAPI_DRIFT=false
# OPENAPI_DRIFT_ENABLED=false
# SCHEDULER_SYNC_INTERVAL_SECONDS=30
# ARCHIVE_INTERVAL_SECONDS=3600
# STARTUP_ARCHIVER_ACCOUNT_ID=0
